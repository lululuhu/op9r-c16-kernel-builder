# ===================================================================
# lemonades_c16_droidspaces.fragment
# Droidspaces 容器运行时支持 + 增强网络配置片段
# Target: OnePlus 9R (lemonades / SM8250) — Linux 4.19 (non-GKI 内核)
#
# 适用场景:
#   - Droidspaces 容器化运行时 (类容器/LXC 风格的 Android 命名空间隔离)
#   - 容器内网络隔离 (NAT / none / bridge 模式)
#   - 防火墙 (UFW / Fail2ban)、IPSet、QoS 与流量整形
#   - 热点 / 网络共享 / IPv6 共享 / 二层网桥 ebtables
#   - WireGuard VPN (已由 wireguard backport 提供，此处确保启用)
#
# 4.19 非 GKI 说明:
#   4.19 为非 GKI (non-GKI) 内核，不存在 vendor hook 抽象层，所有特性需在
#   完整 defconfig 基础上以本片段合并，并通过 merge_config.sh 应用。
#
# 合并方式:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/<base_defconfig> \
#       configs/lemonades_c16_droidspaces.fragment
#
# 规范说明:
#   - 启用项使用 CONFIG_XXX=y
#   - 整数值使用 CONFIG_XXX=N (如 BLK_DEV_LOOP_MIN_COUNT)
#   - 字符串值使用 CONFIG_XXX="..." (如 DEFAULT_TCP_CONG)
#   - 禁用项使用规范格式 "# CONFIG_XXX is not set"
#   - 跨章节重复的选项仅在首次出现处保留，避免重复行
# ===================================================================

# ---- 1. IPC 机制 (IPC Mechanisms) ----
# 进程间通信基础：sysctl / SysV IPC / POSIX 消息队列
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ---- 2. 核心命名空间支持 (Core Namespace Support) ----
# 容器隔离的基础，覆盖 PID/UTS/IPC/NET/USER 命名空间
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# ---- 3. Seccomp 支持 (Seccomp Support) ----
# 系统调用过滤，容器运行时安全沙箱所需
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- 4. 控制组 (Control Groups) ----
# 资源限制与隔离：设备/PID/内存/调度/冻结/网络优先级/BPF
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_BPF=y

# ---- 5. 设备文件系统 (Device Filesystem) ----
# 自动挂载 devtmpfs，提供 /dev 节点
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- 6. Overlay 文件系统 (OverlayFS for Volatile Mode) ----
# Droidspaces volatile (易失) 模式所需的联合挂载
CONFIG_OVERLAY_FS=y

# ---- 7. Tmpfs xattr / acl 支持 ----
# 容器 tmpfs 挂载所需的 POSIX ACL 与扩展属性
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---- 8. 固件加载 (Firmware Loader) ----
# 用户态固件助手 + 压缩固件加载
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# ---- 9. 网络隔离 — NAT / none 模式 (Network Isolation) ----
# veth/bridge/netfilter/NAT 全栈，支撑容器网络命名空间互联
# 注: ANDROID_PARANOID_NETWORK 已在第 18 节以规范格式禁用
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# ---- 10. IPSet 支持 (IPSET Support) ----
# 高性能 IP 集合，用于大规模规则匹配 (容器/Docker/防火墙)
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y

# ---- 11. UFW / Fail2ban 支持 (Firewall Match/Target Modules) ----
# UFW/Fail2ban 所依赖的 iptables 匹配与目标模块
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# ---- 12. 增强 TCP / 拥塞控制与 QoS (Enhanced TCP & Congestion Control) ----
# 多种拥塞算法 + qdisc 调度器 + 分类器，供容器/应用按需选用
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_DEFAULT_TCP_CONG="cubic"
CONFIG_TCP_MD5SIG=y
CONFIG_TCP_FASTOPEN=y
# 队列调度 (qdisc) — FQ/FQ-CoDel/CAKE/HTB/TBF 等
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_GRED=y
CONFIG_NET_SCH_DSMARK=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_QFQ=y
CONFIG_NET_SCH_CODEL=y
# 分类与动作 (cls / act)
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_TCINDEX=y
CONFIG_NET_CLS_ROUTE4=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_RSVP=y
CONFIG_NET_CLS_RSVP6=y
# 扩展匹配 (ematch)
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_CMP=y
CONFIG_NET_EMATCH_NBYTE=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_EMATCH_META=y
CONFIG_NET_EMATCH_TEXT=y

# ---- 13. 热点 / 网络共享增强 (Hotspot / Tethering Improvements) ----
# 连接跟踪标记、统计、IPv6 NAT、二层 ebtables 网桥过滤
# 注: MASQUERADE / MATCH_STATE / MATCH_RECENT 与第 9、11 节共享，
#     已在前述章节启用，此处不再重复，避免配置重复行。
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
# IPv6 防火墙与 NAT (IPv6 热点共享所需)
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE_IPV6=y
# 二层 ebtables (网桥级过滤/转发)
CONFIG_BRIDGE_NF_EBTABLES=y
CONFIG_BRIDGE_EBT_BROUTE=y
CONFIG_BRIDGE_EBT_T_FILTER=y
CONFIG_BRIDGE_EBT_T_NAT=y
CONFIG_BRIDGE_EBT_802_3=y
CONFIG_BRIDGE_EBT_AMONG=y
CONFIG_BRIDGE_EBT_ARP=y
CONFIG_BRIDGE_EBT_IP=y
CONFIG_BRIDGE_EBT_IP6=y
CONFIG_BRIDGE_EBT_LIMIT=y
CONFIG_BRIDGE_EBT_MARK=y
CONFIG_BRIDGE_EBT_PKTTYPE=y
CONFIG_BRIDGE_EBT_STP=y
CONFIG_BRIDGE_EBT_VLAN=y
CONFIG_BRIDGE_EBT_ARPREPLY=y
CONFIG_BRIDGE_EBT_DNAT=y
CONFIG_BRIDGE_EBT_MARK_T=y
CONFIG_BRIDGE_EBT_REDIRECT=y
CONFIG_BRIDGE_EBT_SNAT=y
CONFIG_BRIDGE_EBT_LOG=y
CONFIG_BRIDGE_EBT_NFLOG=y

# ---- 14. WireGuard VPN (确保已启用) ----
# 4.19 非 GKI 通过 mainline-backports/wireguard 提供；此处确保启用
CONFIG_WIREGUARD=y

# ---- 15. 容器所需回环设备 (Loop Block Device for Containers) ----
# 容器镜像/挂载文件所需的 loop 设备，预分配 8 个
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# ---- 16. PTY / devpts 多实例 (PTY/devpts for Containers) ----
# 每个容器命名空间独立的 devpts 实例
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# ---- 17. Cgroup v2 支持 (Cgroup v2) ----
# 统一层级 cgroup v2，配合 Droidspaces 资源管理
CONFIG_CGROUP_V2=y

# ---- 18. 禁用 Android 偏执网络 (容器网络所需) ----
# 关闭 Android paranoid network 校验，否则容器内网络命名空间会被拒绝访问。
# 采用规范 Kconfig 禁用格式。
# CONFIG_ANDROID_PARANOID_NETWORK is not set

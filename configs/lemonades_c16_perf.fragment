# ===================================================================
# lemonades_c16_perf.fragment
# Original config fragment for OnePlus 9R (lemonades / SM8250 / Kona)
# Target: ColorOS 16 (Android 16) bootable + performance/security tuned
#
# This fragment is merged ON TOP of the LineageOS base defconfig.
# It addresses the weaknesses found in the analyzed third-party kernel:
#   - Enables BTF (was missing/weak in stock 4.19)
#   - Enables modern BPF (for Android 16 bpfloader)
#   - Enables full filesystem/crypto stack (f2fs/erofs/inlinecrypt/wrappedkey)
#   - Enables security hardening (FORTIFY, stack protector)
#   - Enables performance features (schedutil, preempt)
#   - Removes debug bloat for leaner image
# ===================================================================

# ---- BPF / BTF (Android 16 hard requirement) ----
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_LWTUNNEL_BPF=y
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_BPF_LSM=y
# Allow unprivileged BPF only if needed (default off for security)
# CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# ---- Filesystems (Android 16 fstab requirements) ----
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y

# ---- Inline encryption / dm-default-key (metadata encryption) ----
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
# QCOM ICE (Inline Crypto Engine) for SM8250
CONFIG_QCOM_ICE=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y

# ---- Scheduler / performance ----
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_SCHED_TUNE=y
CONFIG_EAS_COMPILER_SUPPORT=y
# CPU cluster topology
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# ---- Memory management ----
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHEDTUNE=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# ---- Security hardening (improvements over analyzed kernel) ----
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_STRICT_DEVMEM=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_REFCOUNT_FULL=y
CONFIG_SECURITY_DM_VERITY=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
# KPTI: controlled by workflow input (default off for perf, can enable)
# CONFIG_UNMAP_KERNEL_AT_EL0 is set by defconfig; cmdline toggles at runtime

# ---- Android vendor hooks (for GKI compatibility surface) ----
CONFIG_ANDROID_VENDOR_HOOKS=y

# ---- Modules ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# NOTE: MODULE_SIG disabled — vendor modules use OEM keys, signing would block boot
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# ---- Network (Android 16 netd / tethering BPF) ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_BPF=y

# ---- Remove debug bloat (leaner, faster kernel) ----
# CONFIG_DEBUG_INFO is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_FTRACE is not set  (keep if you need ftrace for debugging)
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DEBUG_PREEMPT is not set

# ---- Thermald / thermal ----
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y

# ---- Input / display / touch ----
CONFIG_INPUT=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=y

# ---- USB ----
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# ---- DMA-BUF / Ion (graphics) ----
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_ION=y

# ---- Watchdog (stability) ----
CONFIG_WATCHDOG=y
CONFIG_QCOM_WATCHDOG=y

# ---- Power supply ----
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_BMS=y
CONFIG_QPNP_FG=y

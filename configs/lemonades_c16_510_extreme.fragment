# ===================================================================
# lemonades_c16_510_extreme.fragment
# EXTREME config fragment for OnePlus 9R on 5.10 baseline
# Maximum mainline features + aggressive performance tuning
#
# Includes everything from lemonades_c16_510.fragment plus:
#   - KFENCE (5.12 backport to 5.10)
#   - DAMON (5.15 backport to 5.10)
#   - MGLRU (6.1 backport to 5.10) [experimental, high risk]
#   - BBR v2 (5.18+ backport) [experimental]
#   - uclamp full integration
#   - Aggressive scheduler/memory tuning
# ===================================================================

# ---- BPF / BTF (native 5.10) ----
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_LSM=y
CONFIG_BPF_PRELOAD=y
CONFIG_BPF_PRELOAD_UMD=y

# ---- uclamp: full integration (native 5.3+) ----
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# ---- Energy model ----
CONFIG_ENERGY_MODEL=y

# ---- io_uring (native 5.10) + enhancements ----
CONFIG_IO_URING=y

# ---- fs-verity (native 5.4+) ----
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y

# ---- PSI (native 4.20+) ----
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=y

# ---- KFENCE (5.12 backport to 5.10) ----
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255

# ---- DAMON (5.15 backport to 5.10) ----
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_DBGFS=y
CONFIG_DAMON_RECLAIM=y

# ---- MGLRU: Multi-Gen LRU (6.1 backport to 5.10) [experimental] ----
# Only enable if MGLRU patchset was applied successfully
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=y

# ---- TCP BBR v2 (5.18+ backport) [experimental] ----
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="cubic"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# ---- CFI + LTO ----
CONFIG_LTO=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_PERMISSIVE=y

# ---- Scheduler: aggressive ----
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPT_NOTIFIERS=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
# SCHED_DEBUG/SCHEDSTATS 收集调度统计，拖慢运行且仅用于调试
# CONFIG_SCHED_DEBUG is not set
CONFIG_SCHED_INFO=y
# CONFIG_SCHEDSTATS is not set
CONFIG_SCHED_HRTICK=y
CONFIG_SCHED_AUTOGROUP=y

# ---- CPU frequency governors ----
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_TIMES=y

# ---- Memory management ----
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_THP_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
CONFIG_ZRAM_WRITEBACK=y
# zram 6.6 backport: 多压缩流 + 重压缩
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_DEF_RECOMP_ZSTD=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y
# ZRAM 内存跟踪 (调试用，生产环境关闭以减少开销)
# CONFIG_ZRAM_MEMORY_TRACKING is not set
CONFIG_ZSMALLOC=y
# ZSMALLOC_STAT 调试统计，生产环境关闭
# CONFIG_ZSMALLOC_STAT is not set
# zsmalloc 6.12 backport: per-size_class lock (性能改善)
# zpdesc 抽象仅在使用 --all 生成补丁后启用
CONFIG_ZPOOL=y
CONFIG_SWAP=y

# ---- Filesystems ----
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4_COMPRESS=y
CONFIG_F2FS_FS_ZSTD_COMPRESS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_LZ4HC=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# ---- Inline encryption ----
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_QCOM_ICE=y

# ---- Security (maximum) ----
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_STRICT_DEVMEM=y
CONFIG_HARDENED_USERCOPY=y
# 关闭回退模式，强化校验
# CONFIG_HARDENED_USERCOPY_FALLBACK is not set
CONFIG_REFCOUNT_FULL=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity"
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y

# ---- cgroup v2 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y

# ---- Block IO ----
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_DEV_THROTTLING_LOW=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_BLK_SED_OPAL=y

# ---- Module signing ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# NOTE: MODULE_SIG disabled — vendor modules use OEM keys, signing would block boot
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# ---- DMA-BUF heaps ----
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_ION=y

# ---- Thermal ----
CONFIG_THERMAL=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_CLOCK_THERMAL=y

# ---- Watchdog ----
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_QCOM_WATCHDOG=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120

# ---- Android vendor hooks ----
CONFIG_ANDROID_VENDOR_HOOKS=y

# ---- Disable debug bloat ----
# CONFIG_DEBUG_INFO is not set
# CONFIG_KASAN is not set
# CONFIG_KCOV is not set
# CONFIG_DEBUG_KMEMLEAK is not set
